{
  "name": "MyneWallet: Budget Tracker",
  "short_name": "MyneWallet",
  "description": "A private, offline-first budget planner and expense tracker for Android. No account, no bank login, no trackers.",
  "start_url": "/mynewallet/",
  "scope": "/mynewallet/",
  "display": "browser",
  "background_color": "#030303",
  "theme_color": "#030303",
  "lang": "en",
  "dir": "ltr",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "/mynewallet/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/assets/apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "related_applications": [
    {
      "platform": "play",
      "id": "com.thebrinklabs.mynewallet.expensetracker",
      "url": "https://play.google.com/store/apps/details?id=com.thebrinklabs.mynewallet.expensetracker"
    }
  ],
  "prefer_related_applications": true
}
